# Скопируйте в .env и задайте свои значения
SECRET_KEY=замените-на-длинную-случайную-строку-от-32-символов
POSTGRES_PASSWORD=замените-пароль
BOT_TOKEN=токен-от-@BotFather
# необязательно: список Telegram ID через запятую, которым разрешён бот
ALLOWED_TELEGRAM_IDS=
MAX_UPLOAD_MB=200
MAX_UNPACKED_MB=2048
RETENTION_DAYS=7
